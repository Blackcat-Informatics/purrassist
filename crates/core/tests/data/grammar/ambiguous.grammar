#
# Test-only, deliberately ambiguous dialect: a lone word in a call is either
# the tool name or the call id, so every call has two equal-cost readings.
grammar "ambiguous.v1";

word = /[a-z]+/;

call = "<c>" (name:word | id:word) "</c>";

result = "<r>" content:until("</r>") "</r>";

declaration = "<d>" name:word "</d>";
