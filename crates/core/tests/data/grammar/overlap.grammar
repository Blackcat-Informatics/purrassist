#
# Test-only dialect sharing mini.v1's call wrapper: a call both dialects
# recognize over the same span is an overlapping-dialect choice.
grammar "overlap.v1";

ident = /[A-Za-z_][A-Za-z0-9_.:-]*/;

call = "<tool><call=" name:ident ">" arguments:slot(raw, "</call>") "</call></tool>";

result = "<result>" content:until("</result>") "</result>";

declaration = "<fn " name:ident ">";
