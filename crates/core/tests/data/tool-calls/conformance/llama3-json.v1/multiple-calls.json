        "name": "read_file",
        "description": "Read a text file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "limit": {
              "type": "integer"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    }
  ],
  "expected_calls": [
