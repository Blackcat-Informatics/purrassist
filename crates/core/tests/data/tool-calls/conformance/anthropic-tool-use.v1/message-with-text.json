{
  "description": "An assistant message whose content array holds a text block and two tool_use blocks, pretty-printed with one space after each colon and comma. The text block and the envelope are content; each block is one call.",
  "markup": "{\"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"Checking both.\"}, {\"type\": \"tool_use\", \"id\": \"toolu_01\", \"name\": \"get_weather\", \"input\": {\"city\": \"Oslo\"}}, {\"type\": \"tool_use\", \"id\": \"toolu_02\", \"name\": \"read_file\", \"input\": {\"path\": \"notes.txt\", \"limit\": 10}}]}",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Current weather for a city.",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            },
            "unit": {
              "type": "string",
              "enum": [
                "celsius",
                "fahrenheit"
              ]
            }
          },
          "required": [
            "city"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a text file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "limit": {
              "type": "integer"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    }
  ],
  "expected_calls": [
    {
      "name": "get_weather",
      "id": "toolu_01",
      "arguments": {"city": "Oslo"}
    },
    {
      "name": "read_file",
      "id": "toolu_02",
      "arguments": {"path": "notes.txt", "limit": 10}
    }
  ]
}
