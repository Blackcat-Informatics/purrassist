#
# Qwen3-Coder XML tool calls: a <tool_call> wrapper around one
# <function=NAME> element whose body holds <parameter=NAME> elements. The
# body is read by the xml-params codec (verbatim string values, typed values
# parsed as JSON, nested parameters, a whole-JSON body, the </parameters>
# closer variant), typed by the declared tool the name refers to. Several
# calls follow one another, each in its own wrapper. First-party grammar;
# see docs/tool-calls/dialects/qwen3-coder-xml.v1.md for the public sources
# describing the format and for what is deliberately not accepted.
grammar "qwen3-coder-xml.v1";

reasoning "<think>" "</think>";

closer function-end = "</function>" | "</functions>";
closer call-end = "</tool_call>" | "</tool_calls>";

tool-name = /[A-Za-z0-9_.:-]+/;
ws = /[ \t\r\n]+/;

call = "<tool_call>" ws? "<function=" name:tool-name ">"
       arguments:slot(xml-params, "</function>", "</functions>", "</tool_call>", "</tool_calls>")
       function-end ws? call-end;

# A tool result as the chat template renders a tool message.
result = "<tool_response>" content:until("</tool_response>") "</tool_response>";

# One entry of the system prompt's tool list.
declaration = "<function>" ws? "<name>" name:tool-name "</name>" ws?
              ("<description>" content:until("</description>") "</description>" ws?)?
              "<parameters>" until("</parameters>") "</parameters>" ws?
              "</function>";
