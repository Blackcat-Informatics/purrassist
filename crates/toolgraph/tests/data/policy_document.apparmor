abi <abi/4.0-ip>,
profile purrassist.standalone flags=(attach_disconnected) {
  audit deny "/home/example/.ssh/**" rwx,
  audit deny "/**/.env*" rwx,
  deny capability sys_admin,
  deny capability sys_ptrace,
  deny capability sys_module,
  deny capability sys_rawio,
  deny capability net_admin,
  deny capability dac_override,
  deny capability dac_read_search,
  deny capability setuid,
  deny capability setgid,
  deny capability mknod,
  deny capability chown,
  deny capability fowner,
  deny capability kill,
  deny capability net_bind_service,
  deny ptrace (trace, read, readby, tracedby) peer="**",
  deny mount,
  deny remount,
  deny umount,
  deny pivot_root,
  owner "/srv/policy workspace/**" rwkl,
  network (connect) inet stream peer=(ip=10.0.0.7 port=5432),
  unix (send, receive) type=stream addr="@/run/policy-example/ipc" peer=(label="purrassist.tools" addr="@/run/policy-example/host"),
  signal (receive) set=(int, term) peer="purrassist.tools",
  audit deny ptrace (read) peer="purrassist.tools",
  capability net_raw,
  audit deny mount,
  set rlimit as <= 268435456,
  set rlimit fsize <= 1048576,
  set rlimit nproc <= 16,
  set rlimit cpu <= 5 seconds,
  set rlimit nofile <= 64,
}
profile purrassist.tools flags=(attach_disconnected) {
  audit deny "/home/example/.ssh/**" rwx,
  audit deny "/**/.env*" rwx,
  deny capability sys_admin,
  deny capability sys_ptrace,
  deny capability sys_module,
  deny capability sys_rawio,
  deny capability net_admin,
  deny capability dac_override,
  deny capability dac_read_search,
  deny capability setuid,
  deny capability setgid,
  deny capability mknod,
  deny capability chown,
  deny capability fowner,
  deny capability kill,
  deny capability net_bind_service,
  deny ptrace (trace, read, readby, tracedby) peer="**",
  deny mount,
  deny remount,
  deny umount,
  deny pivot_root,
  ^worker {
    audit deny "/home/example/.ssh/**" rwx,
    audit deny "/**/.env*" rwx,
    deny capability sys_admin,
    deny capability sys_ptrace,
    deny capability sys_module,
    deny capability sys_rawio,
    deny capability net_admin,
    deny capability dac_override,
    deny capability dac_read_search,
    deny capability setuid,
    deny capability setgid,
    deny capability mknod,
    deny capability chown,
    deny capability fowner,
    deny capability kill,
    deny capability net_bind_service,
    deny ptrace (trace, read, readby, tracedby) peer="**",
    deny mount,
    deny remount,
    deny umount,
    deny pivot_root,
    owner "/srv/policy workspace/**" rwkl,
    network (connect) inet stream peer=(ip=10.0.0.7 port=5432),
    unix (send, receive) type=stream addr="@/run/policy-example/ipc" peer=(label="purrassist.tools" addr="@/run/policy-example/host"),
    signal (receive) set=(int, term) peer="purrassist.tools",
    audit deny ptrace (read) peer="purrassist.tools",
    capability net_raw,
    audit deny mount,
    set rlimit as <= 268435456,
    set rlimit fsize <= 1048576,
    set rlimit nproc <= 16,
    set rlimit cpu <= 5 seconds,
    set rlimit nofile <= 64,
  }
  ^zeta {
    audit deny "/home/example/.ssh/**" rwx,
    audit deny "/**/.env*" rwx,
    deny capability sys_admin,
    deny capability sys_ptrace,
    deny capability sys_module,
    deny capability sys_rawio,
    deny capability net_admin,
    deny capability dac_override,
    deny capability dac_read_search,
    deny capability setuid,
    deny capability setgid,
    deny capability mknod,
    deny capability chown,
    deny capability fowner,
    deny capability kill,
    deny capability net_bind_service,
    deny ptrace (trace, read, readby, tracedby) peer="**",
    deny mount,
    deny remount,
    deny umount,
    deny pivot_root,
  }
}
