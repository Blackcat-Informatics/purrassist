+/// A fallibly allocated single value with its own reservation. A one-element
+/// vector avoids unsafe allocation conversion and admits storage before use.
+#[derive(Debug)]
+pub(crate) struct CodecBox<T> {
+    values: Vec<T>,
+    storage: ScratchLease,
+}
+
+impl<T: ScratchCharge> CodecBox<T> {
+    fn new(value: T, governor: &mut Governor) -> Result<Self, StopReason> {
+        governor.charge(Resource::Work, 1)?;
+        let mut values = ScratchVec::with_exact_capacity(1, governor)?;
+        values.push(value)?;
+        let (values, storage) = values.into_owned_parts();
+        Ok(Self { values, storage })
+    }
+
+    fn into_inner(mut self) -> T {
+        // INVARIANT: construction installs exactly one value and no method
+        // exposes vector mutation; only this consuming operation removes it.
+        self.values
+            .pop()
+            .expect("codec cell contains exactly one value")
+    }
+}
+
+impl<T> core::ops::Deref for CodecBox<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        &self.values[0]
+    }
+}
+
+impl<T> core::ops::DerefMut for CodecBox<T> {
+    fn deref_mut(&mut self) -> &mut T {
+        &mut self.values[0]
+    }
+}
