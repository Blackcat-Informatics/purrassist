+/// A checked accounting transaction for a physical state fork. The destination
+/// begins with the source governor's full snapshot. Each explicitly enumerated
+/// owner is credited at most once, only in that independent destination, before
+/// its replacement storage is admitted. New copying work/storage is cumulative.
+/// Drop the transaction and partial state on any error; the source is read-only.
+#[derive(Debug)]
+pub(crate) struct ForkAccounting<'g> {
+    source: Option<ScratchMeter>,
+    replaced: ScratchVec<usize>,
+    destination: ForkDestination<'g>,
+}
+
+#[derive(Debug)]
+enum ForkDestination<'g> {
+    Independent(Governor),
+    Additional(&'g mut Governor),
+}
+
+impl<'g> ForkAccounting<'g> {
+    /// A sibling configuration inside the same operation needs additional
+    /// physical ownership, not a credit against inherited snapshot debt.
+    pub(crate) fn additional(governor: &'g mut Governor) -> Self {
+        Self {
+            source: None,
+            replaced: ScratchVec::new(governor),
+            destination: ForkDestination::Additional(governor),
+        }
+    }
+
+    pub(crate) fn governor(&mut self) -> &mut Governor {
+        match &mut self.destination {
+            ForkDestination::Independent(governor) => governor,
+            ForkDestination::Additional(governor) => governor,
+        }
+    }
+
+    pub(crate) fn replace_vec<T: ScratchCharge>(
+        &mut self,
+        owner: &ScratchVec<T>,
+    ) -> Result<(), StopReason> {
+        self.replace(
+            owner as *const ScratchVec<T> as usize,
+            &owner.meter,
+            owner.reserved,
+        )
+    }
+
+    pub(crate) fn replace_lease(&mut self, owner: &ScratchLease) -> Result<(), StopReason> {
+        self.replace(
+            owner as *const ScratchLease as usize,
+            &owner.meter,
+            owner.bytes,
+        )
+    }
+
+    fn replace(&mut self, key: usize, meter: &ScratchMeter, bytes: u64) -> Result<(), StopReason> {
+        let governor = match &mut self.destination {
+            ForkDestination::Independent(governor) => governor,
+            ForkDestination::Additional(governor) => governor,
+        };
+        governor.charge(
+            Resource::Work,
+            saturating_size(self.replaced.len())
+                .saturating_mul(2)
+                .saturating_add(2),
+        )?;
+        let Some(source) = &self.source else {
+            return if Arc::ptr_eq(&governor.scratch.0, &meter.0) {
+                Ok(())
+            } else {
+                Err(invalid_input(
+                    "sibling fork owner belongs to a different governor",
+                ))
+            };
+        };
+        if !Arc::ptr_eq(&source.0, &meter.0) {
+            return Err(invalid_input(
+                "fork owner belongs to a different source governor",
+            ));
+        }
+        if bytes == 0 {
+            return Ok(());
+        }
+        if self.replaced.contains(&key) {
+            return Err(invalid_input("fork owner reservation was enumerated twice"));
+        }
+        // Reserve the ledger slot before changing inherited debt. No allocation
+        // or fallible admission remains between credit and recording its owner.
+        self.replaced.reserve(1)?;
+        governor.release_scratch(bytes)?;
+        self.replaced.push(key)
+    }
+
+    pub(crate) fn finish(self) -> Result<Governor, StopReason> {
+        let Self {
+            destination,
+            replaced,
+            source: _,
+        } = self;
+        drop(replaced);
+        match destination {
+            ForkDestination::Independent(governor) => Ok(governor),
+            ForkDestination::Additional(_) => {
+                Err(invalid_input("sibling fork has no independent governor"))
+            }
+        }
+    }
+}
+
+/// Copy a stored failure as internal state, retaining its text under the
+/// destination's aggregate owner rather than publishing another diagnostic.
+pub(crate) fn copy_stop_for_fork(
+    reason: &StopReason,
+    governor: &mut Governor,
+    lease: &mut ScratchLease,
+) -> Result<StopReason, StopReason> {
+    governor.charge(Resource::Work, 1)?;
+    Ok(match reason {
+        StopReason::Completed => StopReason::Completed,
+        StopReason::NoCandidate => StopReason::NoCandidate,
+        StopReason::BudgetExceeded(resource) => StopReason::BudgetExceeded(*resource),
+        StopReason::Cancelled => StopReason::Cancelled,
+        StopReason::InvalidInput(text) => {
+            let (copied, storage) =
+                ScratchString::copy_capacity(text, governor)?.into_owned_parts();
+            lease.absorb(storage);
+            StopReason::InvalidInput(copied)
+        }
+    })
+}
