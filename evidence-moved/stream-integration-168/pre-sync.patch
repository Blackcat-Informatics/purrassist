+fn copy_mode(
+    mode: &Mode,
+    governor: &mut Governor,
+    storage: &mut ScratchLease,
+) -> Result<Mode, StopReason> {
+    governor.charge(Resource::Work, 1)?;
+    let copy = |text: &String, governor: &mut Governor, storage: &mut ScratchLease| {
+        let (text, owned) = ScratchString::copy_capacity(text, governor)?.into_owned_parts();
+        storage.absorb(owned);
+        Ok::<_, StopReason>(text)
+    };
+    Ok(match mode {
+        Mode::Space(after) => Mode::Space(*after),
+        Mode::Slash { at, then } => Mode::Slash {
+            at: *at,
+            then: *then,
+        },
+        Mode::LineComment { start, then } => Mode::LineComment {
+            start: *start,
+            then: *then,
+        },
+        Mode::BlockComment { start, star, then } => Mode::BlockComment {
+            start: *start,
+            star: *star,
+            then: *then,
+        },
+        Mode::Token { start, key, text } => Mode::Token {
+            start: *start,
+            key: *key,
+            text: copy(text, governor, storage)?,
+        },
+        Mode::Text(text) => Mode::Text(Text {
+            start: text.start,
+            quote: text.quote,
+            key: text.key,
+            canonical: text.canonical,
+            value: copy(&text.value, governor, storage)?,
+            escape: text.escape,
+            slice: text.slice,
+        }),
+        Mode::Done => Mode::Done,
+    })
+}
+
+fn copy_frame(
+    frame: &Frame,
+    governor: &mut Governor,
+    storage: &mut ScratchLease,
+) -> Result<Frame, StopReason> {
+    governor.charge(Resource::Work, 1)?;
+    // Open parser frames are an explicit stack, independent of the physical
+    // recursion needed to copy each already completed child subtree.
+    // `frame.depth` is the next child's prospective depth. Its container's
+    // already admitted depth is one less, even when that frame is still empty.
+    governor.charge(Resource::Depth, u64::from(frame.depth.saturating_sub(1)))?;
+    let depth = 0;
+    let items = super::document::copy_items_for_fork(
+        &frame.items,
+        frame.items.capacity(),
+        governor,
+        storage,
+        depth,
+    )?;
+    let members = super::document::copy_members_for_fork(
+        &frame.members,
+        frame.members.capacity(),
+        governor,
+        storage,
+        depth,
+    )?;
+    let key = frame
+        .key
+        .as_ref()
+        .map(|(key, span)| {
+            let (key, owned) = ScratchString::copy_capacity(key, governor)?.into_owned_parts();
+            storage.absorb(owned);
+            Ok::<_, StopReason>((key, span.clone()))
+        })
+        .transpose()?;
+    Ok(Frame {
+        start: frame.start,
+        depth: frame.depth,
+        object: frame.object,
+        items,
+        members,
+        key,
+        container: frame.container,
+    })
+}
