+fn copy_state_node(
+    node: &Node,
+    governor: &mut Governor,
+    lease: &mut ScratchLease,
+    depth: u32,
+) -> Result<Node, StopReason> {
+    governor.charge(Resource::Work, 1)?;
+    governor.charge(Resource::Depth, u64::from(depth))?;
+    if depth > 128 {
+        return Err(governor.stop_resource(Resource::Depth));
+    }
+    let value = match &node.value {
+        Value::Null => Value::Null,
+        Value::Bool(value) => Value::Bool(*value),
+        Value::Number(number) => Value::Number(number.copy_for_fork(governor, lease)?),
+        Value::String(text) => {
+            let (text, storage) = ScratchString::copy_capacity(text, governor)?.into_owned_parts();
+            lease.absorb(storage);
+            Value::String(text)
+        }
+        Value::Array(items) => Value::Array(copy_items_for_fork(
+            items,
+            items.capacity(),
+            governor,
+            lease,
+            depth,
+        )?),
+        Value::Object(members) => Value::Object(copy_members_for_fork(
+            members,
+            members.capacity(),
+            governor,
+            lease,
+            depth,
+        )?),
+    };
+    Ok(Node {
+        value,
+        span: node.span.clone(),
+    })
+}
+
+pub(super) fn copy_items_for_fork(
+    items: &[Node],
+    capacity: usize,
+    governor: &mut Governor,
+    lease: &mut ScratchLease,
+    depth: u32,
+) -> Result<Vec<Node>, StopReason> {
+    governor.charge(Resource::Work, 1)?;
+    let mut copied = ScratchVec::with_exact_capacity(capacity, governor)?;
+    for item in items {
+        let item = copy_state_node(item, governor, lease, depth + 1)?;
+        push(&mut copied, item, governor)?;
+    }
+    let (items, storage) = copied.into_owned_parts();
+    lease.absorb(storage);
+    Ok(items)
+}
+
+pub(super) fn copy_members_for_fork(
+    members: &[Member],
+    capacity: usize,
