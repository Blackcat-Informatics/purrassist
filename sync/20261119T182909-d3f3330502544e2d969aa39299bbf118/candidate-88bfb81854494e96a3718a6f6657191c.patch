+            worked().as_bytes(),
+            "text/turtle",
+            None,
+            &vocabulary,
+            &mut limited,
+        )
+        .unwrap_err(),
+        LoadError::Exhausted(StopReason::BudgetExceeded(Resource::Work))
+    );
+    assert_eq!(meter.live(), baseline);
+    meter.release(baseline).unwrap();
+}
