+        let (PartReadings::Call(readings), PartReadings::Call(mut call)) = (readings, part) else {
+            continue;
+        };
+        let call = call.remove(0);
+        if !readings.contains(&call) {
+            // Every reading beyond the first competes.
+            if !readings.is_empty() {
