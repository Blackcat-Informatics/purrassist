+    }
+    let ([exact], [derived]) = (native.readings.as_slice(), shadow.readings.as_slice()) else {
+        return Ok(EmbeddedRelation::Both);
+    };
+    if same_embedded_invocation(exact, derived, governor)? {
+        Ok(preference)
+    } else {
+        Ok(EmbeddedRelation::Both)
