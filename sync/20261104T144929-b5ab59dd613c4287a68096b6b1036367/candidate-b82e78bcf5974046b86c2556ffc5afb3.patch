+        options: &[Vec<ResolvedSegment>],
+        span: &Range<usize>,
+        governor: &mut Governor,
+    ) -> Result<bool, StopReason> {
+        if self.rows.is_empty() {
+            return Ok(false);
+        }
+        let Some(weak) = self.option(piece, member, &options[member], span, governor)? else {
+            return Ok(false);
+        };
