+// SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc.
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Source evidence retained before an attempt's capture window retires.
+
+use super::{Part, Parts};
+use crate::contract::saturating_size as size;
+use crate::contract::{Governor, Resource, ScratchCharge, ScratchVec, StopReason, push_scratch};
+use crate::grammar::CaptureKind;
+use crate::grammar::edit::{EditOperator, MarkupEdit};
+use crate::tool_call::{DialectId, RawCall};
+use core::ops::Range;
+
+/// The exact extraction-retained range and its source-proven whitespace trim.
+/// This is framing evidence only; it never establishes invocation equality.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct SourceEnvelope {
+    retained_start: usize,
+    retained_end: usize,
+    trimmed_start: usize,
+    trimmed_end: usize,
+}
+
+impl ScratchCharge for SourceEnvelope {
+    const CHARGE: usize = 32;
+}
+
+impl SourceEnvelope {
+    pub(crate) fn matches(&self, retained: &Range<usize>, frame: &Range<usize>) -> bool {
+        (self.retained_start, self.retained_end) == (retained.start, retained.end)
+            && (self.trimmed_start, self.trimmed_end) == (frame.start, frame.end)
+    }
+}
+
+/// Structural addresses remain attached to their own completion's parts.
+#[derive(Debug)]
+pub(crate) struct PartEnvelope {
+    pub(crate) part: usize,
+    pub(crate) reading: usize,
+    pub(crate) source: SourceEnvelope,
+}
+
+impl ScratchCharge for PartEnvelope {
+    const CHARGE: usize = 48;
+}
+
+/// Final outgoing parts and their sparse source certificates. The owner moves
+/// through queued and held events without cloning its scratch reservation.
+#[derive(Debug)]
+pub(crate) struct CompletedParts {
+    pub(crate) parts: Parts,
+    pub(crate) envelopes: ScratchVec<PartEnvelope>,
+}
+
+impl ScratchCharge for CompletedParts {
+    const CHARGE: usize = 64;
+}
+
+const _: () = {
+    assert!(core::mem::size_of::<SourceEnvelope>() <= SourceEnvelope::CHARGE);
+    assert!(core::mem::size_of::<PartEnvelope>() <= PartEnvelope::CHARGE);
+    assert!(core::mem::size_of::<CompletedParts>() <= CompletedParts::CHARGE);
+};
+
+/// Certify only the projected dialect whose embedded framing needs this
+/// evidence. All reads occur while the producing attempt retains its source.
+pub(super) fn certify(
+    parts: &[(Part, u64)],
+    base: usize,
+    source: &[u8],
+    governor: &mut Governor,
+) -> Result<ScratchVec<PartEnvelope>, StopReason> {
+    let mut certificates = ScratchVec::new(governor);
+    for (part, (candidate, _)) in parts.iter().enumerate() {
+        governor.charge(Resource::Work, 1)?;
+        let Part::Call(call) = candidate else {
+            continue;
+        };
+        for (reading, raw) in call.readings.iter().enumerate() {
+            governor.charge(Resource::Work, 1)?;
+            if raw.dialect != DialectId::HermesStripped {
+                continue;
+            }
+            let retained = retained_context(raw, governor)?;
+            let bytes = retained
+                .start
+                .checked_sub(base)
+                .zip(retained.end.checked_sub(base))
+                .and_then(|(start, end)| source.get(start..end))
+                .ok_or_else(|| {
+                    StopReason::InvalidInput(
+                        "completed call source retired before envelope certification".into(),
+                    )
+                })?;
+            let (mut start, mut end) = (0, bytes.len());
+            while start < end {
+                governor.charge(Resource::Work, 1)?;
+                if !matches!(bytes[start], b' ' | b'\t' | b'\r' | b'\n') {
+                    break;
+                }
+                start += 1;
+            }
+            while start < end {
+                governor.charge(Resource::Work, 1)?;
+                if !matches!(bytes[end - 1], b' ' | b'\t' | b'\r' | b'\n') {
+                    break;
+                }
+                end -= 1;
+            }
+            if start == 0 && end == bytes.len() {
+                continue;
+            }
+            push_scratch(
+                &mut certificates,
+                PartEnvelope {
+                    part,
+                    reading,
+                    source: SourceEnvelope {
+                        retained_start: retained.start,
+                        retained_end: retained.end,
+                        trimmed_start: retained.start + start,
+                        trimmed_end: retained.start + end,
+                    },
+                },
+                governor,
+            )?;
+        }
+    }
+    Ok(certificates)
+}
+
+/// Only exterior extraction can move a context boundary. An enclosing native
+/// protocol still protects every interior byte, including dropped fence text.
+pub(crate) fn retained_context(
+    reading: &RawCall,
+    governor: &mut Governor,
+) -> Result<Range<usize>, StopReason> {
+    let mut span = reading.span.clone();
+    for edit in &reading.edits {
+        governor.charge(Resource::Work, 1)?;
+        if edit.span.start == span.start
+            && edit.span.end <= span.end
+            && context_extraction(reading, edit, governor)?
+        {
+            span.start = edit.span.end;
+        }
+    }
+    for edit in reading.edits.iter().rev() {
+        governor.charge(Resource::Work, 1)?;
+        if edit.span.end == span.end
+            && edit.span.start >= span.start
+            && context_extraction(reading, edit, governor)?
+        {
+            span.end = edit.span.start;
+        }
+    }
+    Ok(span)
+}
+
+/// Retained capture bytes cannot be removed from Markdown protection.
+fn context_extraction(
+    reading: &RawCall,
+    edit: &MarkupEdit,
+    governor: &mut Governor,
+) -> Result<bool, StopReason> {
+    if edit.span.is_empty()
+        || !matches!(
+            edit.operator,
+            EditOperator::ExtractProse | EditOperator::ExtractFence
+        )
+    {
+        return Ok(false);
+    }
+    governor.charge(Resource::Work, size(reading.captures.len()))?;
+    Ok(!reading.captures.iter().any(|capture| {
+        capture.kind != CaptureKind::Dropped
+            && capture.span.start < edit.span.end
+            && edit.span.start < capture.span.end
+    }))
+}
diff --git crates/core/src/grammar/engine/failure_header.rs crates/core/src/grammar/engine/failure_header.rs
new file mode 100644
index 0000000..68eb3d4
--- /dev/null
+++ crates/core/src/grammar/engine/failure_header.rs
@@ -0,0 +1,528 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc.
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! Selected failed-body facts, completed before histories and source retire.
+
+use super::{Attempt, Engine, Failure, FailureOrigin, HistKind, Inst, Sub, Thread};
+use crate::contract::{
+    Governor, Resource, ScratchCharge, ScratchMap, ScratchVec, StopReason, invalid_input,
+    push_scratch, saturating_size as size,
+};
+use crate::grammar::{CaptureKind, codec::CodecKind};
+use crate::tool_call::{DialectId, ProductionKind, Rejection};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct HeaderSpan {
+    pub(crate) start: usize,
+    pub(crate) end: usize,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct HeaderFacts {
+    pub(crate) name: HeaderSpan,
+    pub(crate) id: Option<HeaderSpan>,
+    pub(crate) arguments: usize,
+    pub(crate) first_retained: usize,
+    pub(crate) dropped: Option<HeaderSpan>,
+    pub(crate) consumed_to: usize,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct FailureWitness {
+    pub(crate) failed_at: usize,
+    pub(crate) reason: Rejection,
+    pub(crate) end: usize,
+    pub(crate) header: HeaderFacts,
+    pub(crate) native: Option<HeaderSpan>,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Selected {
+    at: usize,
+    reason: Rejection,
+    end: usize,
+    consumed_to: usize,
+    header: Option<HeaderFacts>,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub(super) struct State {
+    native: Option<HeaderSpan>,
+    selected: Option<Selected>,
+}
+
+impl ScratchCharge for State {
+    const CHARGE: usize = {
+        assert!(core::mem::size_of::<Self>() <= 192);
+        192
+    };
+}
+
+/// Sorted-map queries and worst-case insertion/removal movement are admitted.
+fn map_work(length: usize, governor: &mut Governor) -> Result<(), StopReason> {
+    governor.charge(
+        Resource::Work,
+        size(length)
+            .saturating_mul(32)
+            .saturating_add(u64::from(length.bit_width() + 1).saturating_mul(4))
+            .saturating_add(64),
+    )
+}
+
+pub(super) fn native(
+    states: &mut ScratchMap<u64, State>,
+    attempt: u64,
+    span: HeaderSpan,
+    governor: &mut Governor,
+) -> Result<(), StopReason> {
+    map_work(states.len(), governor)?;
+    let mut state = states.get(&attempt).copied().unwrap_or_default();
+    state.native = Some(span);
+    states.insert(attempt, state)?;
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Prefix {
+    name: Option<HeaderSpan>,
+    id: Option<HeaderSpan>,
+    dropped: Option<HeaderSpan>,
+    active: Option<(CaptureKind, usize)>,
+    first: usize,
+}
+
+impl Default for Prefix {
+    fn default() -> Self {
+        Self {
+            name: None,
+            id: None,
+            dropped: None,
+            active: None,
+            first: usize::MAX,
+        }
+    }
+}
+
+impl ScratchCharge for Option<Prefix> {
+    const CHARGE: usize = {
+        assert!(core::mem::size_of::<Self>() <= 160);
+        160
+    };
+}
+
+impl Prefix {
+    fn apply(mut self, kind: HistKind, start: usize) -> Option<Self> {
+        match kind {
+            HistKind::Open(kind, at) => {
+                if self.active.is_some() {
+                    return None;
+                }
+                match kind {
+                    CaptureKind::Dropped
+                        if self.dropped.is_none() && self.first == usize::MAX && at == start => {}
+                    CaptureKind::Name if self.name.is_none() => self.first = self.first.min(at),
+                    CaptureKind::Id if self.id.is_none() => self.first = self.first.min(at),
+                    CaptureKind::Arguments if self.name.is_some() => {
+                        self.first = self.first.min(at);
+                    }
+                    _ => return None,
+                }
+                self.active = Some((kind, at));
+            }
+            HistKind::Close(kind, end) => {
+                let (opened, start) = self.active?;
+                if opened != kind || start >= end {
+                    return None;
+                }
+                let span = HeaderSpan { start, end };
+                match kind {
+                    CaptureKind::Dropped => self.dropped = Some(span),
+                    CaptureKind::Name => self.name = Some(span),
+                    CaptureKind::Id => self.id = Some(span),
+                    _ => return None,
+                }
+                self.active = None;
+            }
+            _ => return None,
+        }
+        Some(self)
+    }
+}
+
+impl Engine<'_> {
+    /// A refused qualification drops materialized salvage before its charge.
+    pub(super) fn finalize_failure_end(
+        &mut self,
+        event: super::Event,
+        extended: bool,
+        governor: &mut Governor,
+    ) -> Result<super::Event, StopReason> {
+        if let Err(reason) = self.qualify_failure_end(&event, extended, governor) {
+            let charged = match &event {
+                super::Event::Ended {
+                    salvage: Some(salvage),
+                    ..
+                } => salvage.charged,
+                _ => 0,
+            };
+            drop(event);
+            let _ = governor.release_scratch(charged);
+            return Err(reason);
+        }
+        Ok(event)
+    }
+
+    fn qualify_failure_end(
+        &mut self,
+        event: &super::Event,
+        extended: bool,
+        governor: &mut Governor,
+    ) -> Result<(), StopReason> {
+        if self.failure_headers.is_empty() {
+            return Ok(());
+        }
+        let super::Event::Ended {
+            attempt,
+            start,
+            at,
+            completed,
+            reason,
+            salvage,
+            ..
+        } = event
+        else {
+            return Err(invalid_input(
+                "failure qualification requires an Ended report",
+            ));
+        };
+        map_work(self.failure_headers.len(), governor)?;
+        let Some(state) = self.failure_headers.get(attempt) else {
+            return Ok(());
+        };
+        governor.charge(Resource::Work, 8)?;
+        let valid = !*completed
+            && salvage.is_none()
+            && !extended
+            && state.selected.is_some_and(|selected| {
+                selected.header.is_some() && selected.end == *at && selected.reason == *reason
+            })
+            && state.native.is_none_or(|frame| frame.start == *start);
+        if !valid {
+            self.forget_failure_header(*attempt, governor)?;
+        }
+        Ok(())
+    }
+
+    /// A complete sparse owner survives queued Ended reports by attempt ID.
+    pub(crate) fn forget_failure_header(
+        &mut self,
+        attempt: u64,
+        governor: &mut Governor,
+    ) -> Result<(), StopReason> {
+        if self.failure_headers.is_empty() {
+            return Ok(());
+        }
+        map_work(self.failure_headers.len(), governor)?;
+        self.failure_headers.remove(&attempt);
+        Ok(())
+    }
+
+    pub(crate) fn discard_failure_headers(&mut self, governor: &Governor) {
+        let old = core::mem::replace(&mut self.failure_headers, ScratchMap::new(governor));
+        drop(old);
+    }
+
+    pub(crate) fn take_failure_header(
+        &mut self,
+        attempt: u64,
+        governor: &mut Governor,
+    ) -> Result<Option<FailureWitness>, StopReason> {
+        if self.failure_headers.is_empty() {
+            return Ok(None);
+        }
+        map_work(self.failure_headers.len(), governor)?;
+        let Some(state) = self.failure_headers.remove(&attempt) else {
+            return Ok(None);
+        };
+        Ok(state.selected.and_then(|selected| {
+            selected.header.map(|header| FailureWitness {
+                failed_at: selected.at,
+                reason: selected.reason,
+                end: selected.end,
+                header,
+                native: state.native,
+            })
+        }))
+    }
+
+    /// This runs only when the actual selected failure changes, never per byte.
+    pub(super) fn note_failure_header<'f>(
+        &mut self,
+        table: usize,
+        record: &Attempt,
+        failures: &[Failure],
+        first: &'f Failure,
+        end: usize,
+        governor: &mut Governor,
+    ) -> Result<Option<(&'f Failure, usize)>, StopReason> {
+        if self.tables[table].kind != ProductionKind::Call
+            || !matches!(
+                self.dialect(super::index_u32(table)),
+                DialectId::MistralV3 | DialectId::HermesStripped
+            )
+        {
+            return Ok(None);
+        }
+        if !record.opened {
+            // No unopened contributor can certify; decide retention only
+            // after actual repair and resynchronization have finished.
+            governor.charge(Resource::Work, 1)?;
+            return Ok(Some((first, end)));
+        }
+        let mut header = None;
+        let mut seen = false;
+        for failure in failures.iter().filter(|failure| !failure.respell) {
+            governor.charge(Resource::Work, 3)?;
+            if (failure.at, failure.reason) != (first.at, first.reason) {
+                continue;
+            }
+            let next = self.certify_failure(table, failure, end, governor)?;
+            if seen {
+                header = intersect(header, next, governor)?;
+            } else {
+                header = next;
+                seen = true;
+            }
+        }
+        self.retain_failure_header(record.id, first, end, header, governor)?;
+        Ok(None)
+    }
+
+    /// Complete a borrowed negative selection after actual repair and resynchronization.
+    pub(super) fn finish_unopened_header(
+        &mut self,
+        table: usize,
+        live: &[Thread],
+        completed: &[Thread],
+        pending: Option<(&Failure, usize)>,
+        governor: &mut Governor,
+    ) -> Result<(), StopReason> {
+        let Some((first, end)) = pending else {
+            return Ok(());
+        };
+        governor.charge(Resource::Work, 6)?;
+        let current = &self.tables[table];
+        let terminal = live.is_empty()
+            && completed.is_empty()
+            && current.trails.is_empty()
+            && current.stalled.is_empty()
+            && current.past.is_empty()
+            && current.held.by_attempt.is_empty();
+        // No later settlement producer can revive an owner when all six
+        // sources are empty. The caller selected failures by this attempt ID.
+        if !terminal {
+            self.retain_failure_header(first.thread.attempt, first, end, None, governor)?;
+        }
+        Ok(())
+    }
+
+    /// One persistence path for proved headers and surviving negative selections.
+    fn retain_failure_header(
+        &mut self,
+        attempt: u64,
+        first: &Failure,
+        end: usize,
+        header: Option<HeaderFacts>,
+        governor: &mut Governor,
+    ) -> Result<(), StopReason> {
+        let mut selected = Selected {
+            at: first.at,
+            reason: first.reason,
+            end,
+            consumed_to: first.thread.pos,
+            header,
+        };
+        map_work(self.failure_headers.len(), governor)?;
+        let mut state = self
+            .failure_headers
+            .get(&attempt)
+            .copied()
+            .unwrap_or_default();
+        if let Some(previous) = state.selected
+            && (previous.at, previous.reason) == (selected.at, selected.reason)
+        {
+            governor.charge(Resource::Work, 3)?;
+            selected.header = if previous.end == end && previous.consumed_to == selected.consumed_to
+            {
+                intersect(previous.header, selected.header, governor)?
+            } else {
+                None
+            };
+        }
+        state.selected = Some(selected);
+        self.failure_headers.insert(attempt, state)?;
+        Ok(())
+    }
+
+    /// The producer tag identifies the consumed-codec Unread route precisely.
+    fn certify_failure(
+        &self,
+        table: usize,
+        failure: &Failure,
+        end: usize,
+        governor: &mut Governor,
+    ) -> Result<Option<HeaderFacts>, StopReason> {
+        governor.charge(
+            Resource::Work,
+            size(self.tables[table].attempts.len()).saturating_add(12),
+        )?;
+        let thread = failure.thread;
+        let opened = self.tables[table]
+            .attempts
+            .iter()
+            .any(|attempt| attempt.id == thread.attempt && attempt.opened);
+        if failure.origin != FailureOrigin::UnreadBody
+            || !opened
+            || thread.pending != 0
+            || thread.speculative()
+            || end != failure.at
+            || failure.at >= thread.pos
+            || failure.reason != (Rejection::Malformed { at: failure.at })
+            || !matches!(
+                self.tables[table].program.insts[thread.pc as usize],
+                Inst::Slot {
+                    codec: CodecKind::Json | CodecKind::JsonArgs,
+                    ..
+                }
+            )
+            || !matches!(thread.sub, Sub::Body(_, Some(_)))
+        {
+            return Ok(None);
+        }
+        governor.charge(Resource::Work, 1)?;
+        let byte = thread
+            .entry
+            .checked_sub(self.base)
+            .and_then(|offset| self.buffer.as_slice().get(offset))
+            .ok_or_else(|| invalid_input("failed argument source retired before header proof"))?;
+        if *byte != b'{' {
+            return Ok(None);
+        }
+        let Some(prefix) = self.failure_prefix(thread.hist, thread.start, governor)? else {
+            return Ok(None);
+        };
+        let (Some(name), Some((CaptureKind::Arguments, arguments))) = (prefix.name, prefix.active)
+        else {
+            return Ok(None);
+        };
+        if arguments != thread.entry
+            || name.end > arguments
+            || prefix.id.is_some_and(|id| id.end > arguments)
+            || prefix
+                .dropped
+                .is_some_and(|dropped| dropped.end > prefix.first)
+        {
+            return Ok(None);
+        }
+        Ok(Some(HeaderFacts {
+            name,
+            id: prefix.id,
+            arguments,
+            first_retained: prefix.first,
+            dropped: prefix.dropped,
+            consumed_to: thread.pos,
+        }))
+    }
+
+    /// Memoized prefix summaries prove all Pack branches without path expansion.
+    /// Map shifts are charged, including the conservative quadratic worst case.
+    fn failure_prefix(
+        &self,
+        root: u32,
+        start: usize,
+        governor: &mut Governor,
+    ) -> Result<Option<Prefix>, StopReason> {
+        let mut memo: ScratchMap<u32, Option<Prefix>> = ScratchMap::new(governor);
+        let mut stack = ScratchVec::new(governor);
+        push_scratch(&mut stack, (root, false), governor)?;
+        while let Some((node, finish)) = stack.pop() {
+            map_work(memo.len(), governor)?;
+            if memo.get(&node).is_some() {
+                continue;
+            }
+            governor.charge(Resource::Work, 1)?;
+            let history = self
+                .arena
+                .nodes
+                .as_slice()
+                .get(node as usize)
+                .ok_or_else(|| invalid_input("failed header history is outside its arena"))?;
+            if matches!(
+                history.kind,
+                HistKind::Value(_)
+                    | HistKind::Edit(_)
+                    | HistKind::Link
+                    | HistKind::Next(..)
+                    | HistKind::Skipped(_)
+            ) {
+                map_work(memo.len(), governor)?;
+                memo.insert(node, None)?;
+                continue;
+            }
+            if !finish && !matches!(history.kind, HistKind::Root) {
+                push_scratch(&mut stack, (node, true), governor)?;
+                if let HistKind::Pack(other) = history.kind {
+                    push_scratch(&mut stack, (other, false), governor)?;
+                }
+                push_scratch(&mut stack, (history.prev, false), governor)?;
+                continue;
+            }
+            let summary = Self::failure_prefix_node(history, &memo, start, governor)?;
+            map_work(memo.len(), governor)?;
+            memo.insert(node, summary)?;
+        }
+        map_work(memo.len(), governor)?;
+        memo.get(&root)
+            .copied()
+            .ok_or_else(|| invalid_input("failed header proof did not reach its root"))
+    }
+
+    fn failure_prefix_node(
+        history: &super::HistNode,
+        memo: &ScratchMap<u32, Option<Prefix>>,
+        start: usize,
+        governor: &mut Governor,
+    ) -> Result<Option<Prefix>, StopReason> {
+        if matches!(history.kind, HistKind::Root) {
+            return Ok(Some(Prefix::default()));
+        }
+        map_work(memo.len(), governor)?;
+        let previous = memo
+            .get(&history.prev)
+            .copied()
+            .ok_or_else(|| invalid_input("failed header predecessor was not proved"))?;
+        if let HistKind::Pack(other) = history.kind {
+            map_work(memo.len(), governor)?;
+            let branch = memo
+                .get(&other)
+                .copied()
+                .ok_or_else(|| invalid_input("failed header packed branch was not proved"))?;
+            governor.charge(Resource::Work, 16)?;
+            return Ok(if previous == branch { previous } else { None });
+        }
+        governor.charge(Resource::Work, 8)?;
+        Ok(previous.and_then(|prefix| prefix.apply(history.kind, start)))
+    }
+}
+
+fn intersect(
+    left: Option<HeaderFacts>,
+    right: Option<HeaderFacts>,
+    governor: &mut Governor,
+) -> Result<Option<HeaderFacts>, StopReason> {
+    governor.charge(Resource::Work, 12)?;
+    Ok(match (left, right) {
+        (Some(left), Some(right)) if left == right => Some(left),
+        _ => None,
+    })
+}
diff --git crates/core/src/grammar/engine/insertion.rs crates/core/src/grammar/engine/insertion.rs
new file mode 100644
index 0000000..e051936
--- /dev/null
+++ crates/core/src/grammar/engine/insertion.rs
@@ -0,0 +1,299 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics Inc.
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! The source-contiguous suffix ending at an inserted wrapper closer.
+
+use super::{Arena, HistKind};
+use crate::contract::saturating_size as size;
+use crate::contract::{
+    Governor, Resource, ScratchCharge, ScratchMap, ScratchVec, StopReason, invalid_input,
+    push_scratch,
+};
+use crate::grammar::cost::K_THREAD;
+use crate::grammar::edit::EditOperator;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct Boundary {
+    at: usize,
+    /// Every transparent insertion must share the wrapper's own boundary.
+    inserted: Option<usize>,
+}
+
+impl ScratchCharge for Boundary {
+    const CHARGE: usize = 24;
+}
+
+#[derive(Clone, Copy)]
+enum Rewrite {
+    Guess,
+    Absorb { end: usize },
+}
+
+/// Only certified tail nodes may be rewritten. Their increasing arena indices
+/// order children before parents; captures, values and links never enter it.
+pub(super) struct InsertionTail {
+    root: u32,
+    nodes: ScratchMap<u32, Boundary>,
+}
+
+const _: () = assert!(core::mem::size_of::<Boundary>() <= Boundary::CHARGE);
+
+/// Every packed branch must reach its wrapper without unrecorded source input.
+/// Explicit trailing tokens are transparent only at that same source boundary.
+pub(super) fn ending(
+    arena: &Arena,
+    hist: u32,
+    end: usize,
+    governor: &mut Governor,
+) -> Result<Option<InsertionTail>, StopReason> {
+    certify(arena, hist, end, true, governor)
+}
+
+/// Undo candidates cannot contain an already consumed stray closer: the
+/// wrapper would then precede this absorption's source start. Stop immediately
+/// rather than repeatedly scanning a growing stray-closer history.
+pub(super) fn absorbing(
+    arena: &Arena,
+    hist: u32,
+    end: usize,
+    governor: &mut Governor,
+) -> Result<Option<InsertionTail>, StopReason> {
+    certify(arena, hist, end, false, governor)
+}
+
+/// Ordinary completed captures and unrelated edits need no suffix owner.
+/// Absorption also stops at a previous stray in constant work.
+fn tail_kind(
+    arena: &Arena,
+    hist: u32,
+    strays: bool,
+    governor: &mut Governor,
+) -> Result<bool, StopReason> {
+    governor.charge(Resource::Work, K_THREAD)?;
+    Ok(match arena.nodes[hist as usize].kind {
+        HistKind::Pack(_) => true,
+        HistKind::Edit(index) => {
+            let operator = arena.edits[index as usize].operator;
+            matches!(
+                operator,
+                EditOperator::MissingWrapperClose | EditOperator::MissingToken
+            ) || strays && operator == EditOperator::DeleteStrayCloser
+        }
+        _ => false,
+    })
+}
+
+fn certify(
+    arena: &Arena,
+    hist: u32,
+    end: usize,
+    strays: bool,
+    governor: &mut Governor,
+) -> Result<Option<InsertionTail>, StopReason> {
+    if !tail_kind(arena, hist, strays, governor)? {
+        return Ok(None);
+    }
+    let mut pending = ScratchVec::new(governor);
+    let mut nodes = ScratchMap::<u32, Boundary>::new(governor);
+    push_scratch(
+        &mut pending,
+        (
+            hist,
+            Boundary {
+                at: end,
+                inserted: None,
+            },
+        ),
+        governor,
+    )?;
+    while let Some((at, boundary)) = pending.pop() {
+        governor.charge(Resource::Work, K_THREAD)?;
+        governor.charge(Resource::Work, u64::from(nodes.len().bit_width() + 1))?;
+        if let Some(previous) = nodes.get(&at) {
+            if previous.at != boundary.at
+                || previous
+                    .inserted
+                    .zip(boundary.inserted)
+                    .is_some_and(|(left, right)| left != right)
+            {
+                return Ok(None);
+            }
+            // A shared suffix may arrive directly and through an explicit
+            // token. Revisit only when the latter adds its stronger same-
+            // boundary obligation; the weaker path cannot invalidate it.
+            if previous.inserted.is_some() || boundary.inserted.is_none() {
+                continue;
+            }
+        }
+        governor.charge(
+            Resource::Work,
+            size(nodes.len()).saturating_mul(2).saturating_add(1),
+        )?;
+        nodes.insert(at, boundary)?;
+        let node = arena.nodes[at as usize];
+        match node.kind {
+            HistKind::Edit(index) => {
+                let edit = &arena.edits[index as usize];
+                match edit.operator {
+                    EditOperator::MissingWrapperClose
+                        if edit.span.start == boundary.at
+                            && edit.span.end == boundary.at
+                            && edit.original.is_empty()
+                            && !edit.replacement.is_empty()
+                            && boundary.inserted.is_none_or(|at| at == boundary.at) => {}
+                    EditOperator::MissingToken
+                        if edit.span.start == boundary.at
+                            && edit.span.end == boundary.at
+                            && edit.original.is_empty()
+                            && !edit.replacement.is_empty()
+                            && boundary.inserted.is_none_or(|at| at == boundary.at) =>
+                    {
+                        push_scratch(
+                            &mut pending,
+                            (
+                                node.prev,
+                                Boundary {
+                                    inserted: Some(boundary.at),
+                                    ..boundary
+                                },
+                            ),
+                            governor,
+                        )?;
+                    }
+                    EditOperator::DeleteStrayCloser if strays && edit.span.end == boundary.at => {
+                        push_scratch(
+                            &mut pending,
+                            (
+                                node.prev,
+                                Boundary {
+                                    at: edit.span.start,
+                                    ..boundary
+                                },
+                            ),
+                            governor,
+                        )?;
+                    }
+                    _ => return Ok(None),
+                }
+            }
+            HistKind::Pack(other) => {
+                push_scratch(&mut pending, (node.prev, boundary), governor)?;
+                push_scratch(&mut pending, (other, boundary), governor)?;
+            }
+            _ => return Ok(None),
+        }
+    }
+    Ok(Some(InsertionTail { root: hist, nodes }))
+}
+
+impl InsertionTail {
+    /// Relabel only the proved wrapper, preserving explicit token insertions
+    /// and shared histories belonging to other completions.
+    pub(super) fn guess(
+        &self,
+        arena: &mut Arena,
+        governor: &mut Governor,
+    ) -> Result<u32, StopReason> {
+        self.rewrite(arena, Rewrite::Guess, governor)
+    }
+
+    /// Undo only a wrapper whose exact replacement now appears as source.
+    /// Bracket insertions above it remain edits in their original order.
+    pub(super) fn absorb(
+        &self,
+        arena: &mut Arena,
+        start: usize,
+        end: usize,
+        original: &[u8],
+        governor: &mut Governor,
+    ) -> Result<Option<u32>, StopReason> {
+        for &(at, _) in self.nodes.iter() {
+            governor.charge(Resource::Work, K_THREAD)?;
+            let HistKind::Edit(index) = arena.nodes[at as usize].kind else {
+                continue;
+            };
+            let edit = &arena.edits[index as usize];
+            if edit.operator == EditOperator::MissingWrapperClose {
+                governor.charge(Resource::Work, size(original.len()))?;
+                if edit.span.start != start
+                    || original.trim_ascii_start() != edit.replacement.as_slice()
+                {
+                    return Ok(None);
+                }
+            }
+        }
+        self.rewrite(arena, Rewrite::Absorb { end }, governor)
+            .map(Some)
+    }
+
+    fn rewrite(
+        &self,
+        arena: &mut Arena,
+        rewrite: Rewrite,
+        governor: &mut Governor,
+    ) -> Result<u32, StopReason> {
+        let mut rewritten = ScratchMap::new(governor);
+        for &(at, _) in self.nodes.iter() {
+            governor.charge(Resource::Work, K_THREAD)?;
+            let node = arena.nodes[at as usize];
+            let mapped = |child| {
+                rewritten
+                    .get(&child)
+                    .copied()
+                    .ok_or_else(|| invalid_input("certified wrapper tail is not in source order"))
+            };
+            governor.charge(
+                Resource::Work,
+                u64::from(rewritten.len().bit_width() + 1).saturating_mul(2),
+            )?;
+            let changed = match node.kind {
+                HistKind::Edit(index) => {
+                    let edit = &arena.edits[index as usize];
+                    let wrapper = edit.operator == EditOperator::MissingWrapperClose;
+                    match (wrapper, edit.operator, rewrite) {
+                        (true, _, Rewrite::Absorb { .. }) => node.prev,
+                        (true, _, Rewrite::Guess)
+                        | (false, EditOperator::MissingToken, Rewrite::Absorb { .. }) => {
+                            let prev = if wrapper {
+                                node.prev
+                            } else {
+                                mapped(node.prev)?
+                            };
+                            governor.charge(Resource::Work, edit.estimated_bytes())?;
+                            governor.charge(Resource::ScratchBytes, edit.estimated_bytes())?;
+                            let mut edit = edit.clone();
+                            match rewrite {
+                                Rewrite::Guess => {
+                                    edit.operator = EditOperator::MissingWrapperCloseBeforeText;
+                                }
+                                Rewrite::Absorb { end } => {
+                                    // The explicit trailing token follows the
+                                    // now-consumed wrapper in the source ledger.
+                                    edit.span = end..end;
+                                }
+                            }
+                            arena.adopt_edit(prev, edit)?
+                        }
+                        _ => arena.push(mapped(node.prev)?, node.kind)?,
+                    }
+                }
+                HistKind::Pack(other) => arena.pack(mapped(node.prev)?, mapped(other)?)?,
+                _ => {
+                    return Err(invalid_input(
+                        "certified wrapper tail changed before rewriting",
+                    ));
+                }
+            };
+            governor.charge(
+                Resource::Work,
+                size(rewritten.len()).saturating_mul(2).saturating_add(1),
+            )?;
+            rewritten.insert(at, changed)?;
+        }
+        governor.charge(Resource::Work, u64::from(rewritten.len().bit_width() + 1))?;
+        rewritten
+            .get(&self.root)
+            .copied()
+            .ok_or_else(|| invalid_input("certified wrapper tail lost its root"))
+    }
+}
