{
  "description": "Two fenced Gemma calls preserve call order.",
  "markup": "```tool_code\nget_weather(city='Oslo')\n```\n```tool_code\nread_file(path='notes.txt', limit=10)\n```",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Current weather for a city.",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            },
            "unit": {
              "type": "string",
              "enum": [
                "celsius",
                "fahrenheit"
              ]
            }
          },
          "required": [
            "city"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a text file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "limit": {
              "type": "integer"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    }
  ],
  "expected_calls": [
    {
      "name": "get_weather",
      "arguments": {
        "city": "Oslo"
      }
    },
    {
      "name": "read_file",
      "arguments": {
        "path": "notes.txt",
        "limit": 10
      }
    }
  ]
}
